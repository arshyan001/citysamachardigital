{
    "rewrites": [
        {
            "source": "/api/:path*",
            "destination": "https://citysamachardigital.onrender.com/api/:path*"
        },
        {
            "source": "/uploads/:path*",
            "destination": "https://citysamachardigital.onrender.com/uploads/:path*"
        },
        {
            "source": "/news/:id",
            "has": [
                {
                    "type": "header",
                    "key": "User-Agent",
                    "value": "(.*)(WhatsApp|whatsapp|facebookexternalhit|FacebookBot|Twitterbot|twitterbot|TelegramBot|telegrambot|Slackbot|slackbot|Discordbot|discordbot|Googlebot|googlebot|Bingbot|bingbot|LinkedInBot|linkedinbot)(.*)"
                }
            ],
            "destination": "https://citysamachardigital.onrender.com/share/:id"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}